# Leave blank for the all-in-one mode (FastAPI serves this build from the
# same origin — local dev via `npm run dev`'s proxy, or Docker).
#
# Set this when deploying the frontend separately (e.g. Vercel) from the
# backend (e.g. Render/Railway) — point it at the deployed API's base URL,
# no trailing slash.
VITE_API_URL=https://your-backend.onrender.com
