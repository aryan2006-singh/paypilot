# Copy to .env for local development. Every value is optional: with nothing
# set, PayPilot runs open, in demo mode, with template replies.

# --- Security ---------------------------------------------------------------
# Comma-separated API keys. Clients send one as `X-API-Key: <key>`.
# Unset = no authentication (fine locally, not for a public deploy).
PAYPILOT_API_KEYS=
# Refuse to start without keys. Set to 1 in production.
PAYPILOT_REQUIRE_AUTH=0
# Set to 1 behind a proxy (Render) so rate limits use the real client IP.
TRUST_PROXY_HEADERS=0
# Only needed when the frontend is hosted on another origin.
# ALLOWED_ORIGINS=https://paypilot.example.com
# RATE_LIMIT_CHAT_PER_MIN=20
# RATE_LIMIT_READ_PER_MIN=120

# --- Razorpay ---------------------------------------------------------------
# Test or live keys from the Razorpay dashboard. Without them every tool
# returns clearly labelled demo data; with them, real data only.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
# JSON {settlement_id: {"amount": paise, "utr": "..."}} exported from your books.
# LEDGER_PATH=data/ledger.json

# --- AI replies (Claude) ----------------------------------------------------
# With a key, Claude writes each answer from the agents' facts, streamed live.
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=low

# --- Storage & logs ---------------------------------------------------------
# DATABASE_PATH=data/paypilot.db
# ENVIRONMENT=development
# LOG_LEVEL=INFO
# LOG_JSON=false
